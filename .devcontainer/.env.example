# Optional host Claude Code home. This is mounted read-only and the container
# copies settings.json, CLAUDE.md, agents/, commands/, and skills/ into its own
# /home/vscode/.claude (a persistent named volume) on startup.
# Windows example:
# HOST_CLAUDE_HOME=C:\Users\<USER>\.claude
#
# macOS example:
# HOST_CLAUDE_HOME=/Users/<USER>/.claude
HOST_CLAUDE_HOME=

# Claude Code authentication.
# Linux/Windows hosts: ~/.claude/.credentials.json is copied in automatically.
# macOS hosts keep the login in the Keychain, so it cannot be copied. Either run
# `claude` once inside the container and log in (persists in the claude-home
# volume), or run `claude setup-token` on the host and set the token here.
# CLAUDE_CODE_OAUTH_TOKEN=
#
# Alternatively, bill API usage instead of a Claude subscription:
# ANTHROPIC_API_KEY=

# Optional host user home. The container startup script copies .AGENTS.md or
# AGENTS.md from this directory to /home/vscode/AGENTS.md. This keeps relative
# paths in that file aligned with the container user directory.
#
# Windows example:
# HOST_USER_HOME=C:\Users\<USER>
#
# macOS example:
# HOST_USER_HOME=/Users/<USER>
HOST_USER_HOME=

# Optional host .ai-memories checkout. Mounted read-write inside the container
# user directory at /home/vscode/.ai-memories so relative user-level AGENTS
# paths such as .ai-memories/preferences/global_preferences.md stay consistent.
#
# Windows example:
# HOST_AI_MEMORIES_DIR=C:\Users\<USER>\.ai-memories
#
# macOS example:
# HOST_AI_MEMORIES_DIR=/Users/<USER>/.ai-memories
HOST_AI_MEMORIES_DIR=
