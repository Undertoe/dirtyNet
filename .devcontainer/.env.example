# Optional host Codex home. This is mounted read-only and the container copies
# auth/config into its own writable /home/vscode/.codex on startup.
# Windows example:
# HOST_CODEX_HOME=C:\Users\<USER>\.codex
#
# macOS example:
# HOST_CODEX_HOME=/Users/<USER>/.codex
HOST_CODEX_HOME=

# Optional host user home. The container startup script copies .AGENTS.md or
# AGENTS.md from this directory to /home/vscode/AGENTS.md. This keeps relative
# paths in that file aligned with the container user directory.
#
# Windows example:
# HOST_USER_HOME=C:\Users\<USER>
#
# macOS example:
# HOST_USER_HOME=/Users/<USER>
HOST_USER_HOME=

# Optional host .ai-memories checkout. Mounted read-write inside the container
# user directory at /home/vscode/.ai-memories so relative user-level AGENTS
# paths such as .ai-memories/preferences/global_preferences.md stay consistent.
#
# Windows example:
# HOST_AI_MEMORIES_DIR=C:\Users\<USER>\.ai-memories
#
# macOS example:
# HOST_AI_MEMORIES_DIR=/Users/<USER>/.ai-memories
HOST_AI_MEMORIES_DIR=
